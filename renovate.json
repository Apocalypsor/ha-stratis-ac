{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Let the HA test plugin constrain pytest; update it through lockfile maintenance",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["pytest"],
      "rangeStrategy": "replace"
    },
    {
      "description": "Avoid duplicate pre-commit major and minor update PRs",
      "matchManagers": ["pep621"],
      "matchPackageNames": ["pre-commit"],
      "separateMajorMinor": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "pre-commit": {
    "enabled": true
  }
}
